# OpenAI-compatible provider (optional; deterministic engine works without it)
CLAUDE_BASE_URL=https://api.vilao.ai/v1
CLAUDE_API_KEY=
CLAUDE_MODEL=occ/claude-opus-4-8
ENABLE_LLM=false
# Optional explicit commercial rules. Keep [] unless the business has
# approved supplier/category discount semantics, for example:
# MANUAL_PRICING_RULES_JSON=[{"id":"cadi-sun-10","supplier":"CADI-SUN","discount_rate":0.10,"tax_mode":"ex_vat","effective_from":"2026-01-01"}]
MANUAL_PRICING_RULES_JSON=[]
# Conservative semantic fallback controls. LLM is called only for ambiguous
# candidates when the pricing policy explicitly allows it.
LLM_TIMEOUT_SECONDS=30
LLM_MAX_CALLS=20
LLM_MAX_CANDIDATES=10
LLM_MAX_RETRIES=1
LLM_MAX_PROMPT_CHARS=12000
LLM_MAX_TOKENS=800
LLM_RERANK_MARGIN=0.045
# Material current-vs-historical drift above this fraction routes to review.
PRICE_DRIFT_WARNING_THRESHOLD=0.25
DATABASE_URL=sqlite:///./storage/pricing.db
APP_HOST=0.0.0.0
APP_PORT=3000
