# OpenAI-compatible provider (optional; deterministic engine works without it)
CLAUDE_BASE_URL=https://api.vilao.ai/v1
CLAUDE_API_KEY=
CLAUDE_MODEL=occ/claude-opus-4-8
ENABLE_LLM=false
# Conservative semantic fallback controls. LLM is called only for ambiguous
# candidates when the pricing policy explicitly allows it.
LLM_TIMEOUT_SECONDS=30
LLM_MAX_CALLS=20
LLM_MAX_CANDIDATES=10
LLM_MAX_RETRIES=1
LLM_MAX_PROMPT_CHARS=12000
LLM_MAX_TOKENS=800
LLM_RERANK_MARGIN=0.045
DATABASE_URL=sqlite:///./storage/pricing.db
APP_HOST=127.0.0.1
APP_PORT=8000
